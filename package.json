{
  "name": "receiptuary",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:app:smoke": "npm run lint && npm run build",
    "test:contract": "hardhat test",
    "test": "npm run test:contract && npm run test:app:smoke",
    "preflight:prod": "node scripts/preflight-production.mjs",
    "contract:compile": "hardhat compile",
    "contract:deploy:base": "hardhat run scripts/deploy.ts --network baseSepolia",
    "contract:deploy:base:sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "contract:deploy:base:mainnet": "hardhat run scripts/deploy.ts --network base",
    "contract:issuer:approve:base:sepolia": "hardhat run scripts/set-issuer-approval.ts --network baseSepolia",
    "contract:issuer:approve:base:mainnet": "hardhat run scripts/set-issuer-approval.ts --network base"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.100.13",
    "ethers": "^6.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "viem": "2.48.11",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.12",
    "@nomicfoundation/hardhat-mocha": "^3.0.20",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "hardhat": "^3.5.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
